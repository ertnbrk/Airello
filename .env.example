# ================================
# Spring Boot Configuration
# ================================
SPRING_PROFILE=dev

# ================================
# Server Configuration
# ================================
SERVER_PORT=8080

# ================================
# Database Configuration
# ================================
DB_URL=jdbc:postgresql://localhost:5433/planmate
DB_USER=planmate
DB_PASS=secret

# ================================
# JWT Configuration
# ================================
# Generate secure secret: openssl rand -base64 32
JWT_SECRET=xtozE6ozyuhgkcJC7boSTI65p2Kwv4aUWRU1oYR2c4k=
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION=2592000000 # 30 days

# ================================
# Security
# ================================
ENABLE_AUTH=true

# ================================
# Feature Flags
# ================================
AI_ENABLED=true
PAYMENTS_ENABLED=false
ARTIFACTS_ENABLED=false
REDIS_ENABLED=true

# ================================
# Redis Configuration
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# AWS/MinIO S3 Configuration (Only if ARTIFACTS_ENABLED=true)
# ================================
# For local MinIO (if needed):
# AWS_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# S3_BUCKET=planmate-artifacts

# For production AWS (if needed):
# AWS_ENDPOINT=
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=eu-central-1
# S3_BUCKET=planmate-artifacts

# ================================
# Google OAuth2 Configuration
# ================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth2/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# ================================
# Stripe Configuration
# ================================
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ================================
# Demo Mode Configuration
# ================================
DEMO_EXPIRATION_HOURS=24

# ================================
# Limits
# ================================
UPLOAD_MAX_SIZE_MB=50
AI_REQUESTS_FREE=20
AI_REQUESTS_DEMO=1
AI_REQUESTS_PRO=200

# ================================
# CORS Configuration
# ================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:4200

# ================================
# Logging
# ================================
LOG_LEVEL=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=INFO
LOG_LEVEL_SQL_PARAMS=INFO

# ================================
# OpenTelemetry (Observability)
# ================================
# Leave empty to disable Zipkin tracing
# OTEL_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
TRACING_SAMPLE_RATE=0.1

# ================================
# AI Worker Configuration (LLMOps Platform)
# ================================
# Queue key for Redis LIST-based job queue
AI_QUEUE_KEY=ai:jobs

# Shared secret between Java API and Python worker
# SECURITY: Change this to a strong random string in production!
# Generate: openssl rand -base64 32
WORKER_TOKEN=changeme-worker-secret-token

# LLM Provider for Python worker: "openai" | "ollama" | "mock"
# - openai: Uses OpenAI API (requires OPENAI_API_KEY)
# - ollama: Uses local Ollama instance
# - mock: Returns mock data (no API calls)
LLM_TYPE=mock

# OpenAI Configuration (for Python worker and semantic cache)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ================================
# Ollama Configuration (Optional)
# ================================
# For local LLM deployment without API costs
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ================================
# Worker Tuning
# ================================
# Redis BRPOP timeout in seconds
WORKER_POLL_TIMEOUT=10

# ================================
# Semantic Cache Configuration
# ================================
AI_SEMANTIC_CACHE_ENABLED=true
AI_SEMANTIC_CACHE_THRESHOLD=0.95
